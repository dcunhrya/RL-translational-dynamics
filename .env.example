# Copy to ".env" in the repo root and fill in. ".env" is gitignored.
# Use only simple KEY=value lines (optional quotes if values contain spaces).
#
#   cp .env.example .env
#   $EDITOR .env
#
# setup.sh loads ".env" automatically. Under sudo, empty HF_TOKEN/WANDB_API_KEY in the
# environment still get replaced by the values here (no need for new keys).

WANDB_API_KEY=